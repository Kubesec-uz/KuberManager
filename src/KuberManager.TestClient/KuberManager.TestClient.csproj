<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KuberManager.TestClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\KuberManager.Service\Protos\common.proto"         GrpcServices="None"   ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\deployment.proto"     GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\pod.proto"            GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\health.proto"         GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\namespace.proto"      GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\configmap.proto"      GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\service.proto"        GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\secret.proto"         GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\ingress.proto"        GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\statefulset.proto"    GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\daemonset.proto"      GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\job.proto"            GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\node.proto"           GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\pvc.proto"            GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\hpa.proto"            GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\serviceaccount.proto" GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\rbac.proto"           GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
    <Protobuf Include="..\KuberManager.Service\Protos\networkpolicy.proto"  GrpcServices="Client" ProtoRoot="..\KuberManager.Service" />
  </ItemGroup>

</Project>
