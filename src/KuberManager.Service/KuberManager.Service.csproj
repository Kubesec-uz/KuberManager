<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\common.proto" GrpcServices="None" />
    <Protobuf Include="Protos\deployment.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\pod.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\health.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\namespace.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\configmap.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\service.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\secret.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\ingress.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\statefulset.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\daemonset.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\job.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\node.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\pvc.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\hpa.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\serviceaccount.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\rbac.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\networkpolicy.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.76.0" />
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
