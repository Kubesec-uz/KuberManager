{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Grpc": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  },
  "Kubernetes": {
    "UseInClusterConfig": false,
    "Clusters": {
      "default": ""
    }
  },
  "Policy": {
    "AllowedNamespaces": [],
    "BlockedDeployments": [],
    "MaxReplicas": 20
  }
}
